{
  "apiVersion": "shv.symphony.quanux.org/v1",
  "kind": "HardwareVector",
  "metadata": {
    "node_id": "node-spark-01",
    "chassis_type": "nvidia-dgx-spark-arm64"
  },
  "spec": {
    "cpu_topology": {
      "arch": "aarch64",
      "total_cores": 72,
      "numa_nodes": [0],
      "affinity_masks": {
        "sovereign_symphony_fastpath": "0-15",
        "dgx_cuda_daemon_threads": "16-23",
        "dynamic_agent_gateway": "24-31",
        "system_os_reserved": "32-71"
      }
    },
    "memory_topology": {
      "total_unified_memory_gb": 128,
      "interconnect": "nvlink_c2c",
      "coherency": true,
      "bandwidth_tb_per_sec": 0.9,
      "mlockall_enforced": true,
      "allocations": {
        "symphony_pinned_shm_mb": 8192,
        "accelerator_direct_pool_gb": 96,
        "agent_gateway_limit_mb": 4096
      }
    },
    "accelerator": {
      "device_index": 0,
      "model": "Blackwell-SM120",
      "target_sm": "sm_120",
      "compute_mode": "ExclusiveProcess",
      "power_limit_watts": 350,
      "precision_modes": ["NVFP4", "FP8_E4M3", "FP16", "FP32"],
      "clocks": {
        "graphics_mhz": "max_locked",
        "memory_mhz": "max_locked"
      },
      "stream_priorities": {
        "symphony_hotpath": -1,
        "dynamic_agents": 0
      },
      "thermal_guard": {
        "throttle_temp_celsius": 85,
        "shutdown_temp_celsius": 92
      }
    }
  }
}
