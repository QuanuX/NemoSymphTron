{
  "apiVersion": "scv.symphony.quanux.org/v1",
  "kind": "ClusterTopology",
  "metadata": {
    "name": "rubin-superpod-quant-mesh",
    "provider": "on-prem-vera-rubin"
  },
  "spec": {
    "fabric": {
      "type": "nvlink_network_v6",
      "port_speed_gbps": 800,
      "interfaces": ["mlx8_0", "mlx8_1"],
      "mtu": 9000,
      "interconnect": "nvlink_v6_osfp_switch",
      "gpudirect_rdma": true,
      "hardware_offload": {
        "in_network_reduction": true,
        "sharp_version": "v4",
        "target_dpu": "bluefield-4",
        "offload_lock_manager": true
      }
    },
    "aggregate_memory_gb": 576,
    "recommended_model_tier": "nvidia/nemotron-4-400b-moe-nvfp4 + multi-model pool",
    "nodes": [
      {
        "id": "rubin-node-01",
        "role": "leader",
        "arch": "aarch64_v9",
        "host": "10.200.1.1",
        "shm_path": "/nemosymphtron_rubin_fastpath",
        "memory_pool_gb": 288,
        "cuda_compute_sm": 130
      },
      {
        "id": "rubin-node-02",
        "role": "worker",
        "arch": "aarch64_v9",
        "host": "10.200.1.2",
        "shm_path": "/nemosymphtron_rubin_fastpath",
        "memory_pool_gb": 288,
        "cuda_compute_sm": 130
      }
    ]
  }
}
